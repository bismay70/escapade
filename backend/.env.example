# No keys are needed to try the clearly labelled local sample planner.
# Set one AI provider. Groq matches the original dummy backend.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Alternatively LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional live web research and current weather
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
# Optional remote Tavily MCP instead of the direct Tavily API
TAVILY_MCP_URL=
# Optional flight status data (this API does NOT provide bookable fares)



AVIATIONSTACK_API_KEY=
# Structured flight/hotel inventory and repricing: Amadeus application API key/secret.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
# Explicit authenticated flight orders; the assistant never submits orders.
AMADEUS_ENABLE_RESERVATIONS=false
# Production orders additionally require provider booking access and a consolidator.
AMADEUS_ENABLE_LIVE_RESERVATIONS=false
# Firebase Admin project must match frontend NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
# Keep private JSON credentials in ignored backend/.secrets/, never frontend files.
FIREBASE_SERVICE_ACCOUNT_PATH=.secrets/firebase-service-account.json
# Hosted Stripe Checkout: start with sk_test_...; live charging is disabled.
STRIPE_SECRET_KEY=
# Signing secret from Stripe CLI listen or Dashboard endpoint, beginning whsec_.
STRIPE_WEBHOOK_SECRET=
# Checkout return URLs must match this exact origin.
FRONTEND_ORIGIN=http://localhost:3000
# Required on BOTH services before deploying beyond localhost
BACKEND_SERVICE_KEY=
# Relative paths resolve against backend/, never the shell's working directory
DATABASE_PATH=data/vacanes.sqlite3
