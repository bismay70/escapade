BACKEND_URL=http://127.0.0.1:8000
# Must match backend/.env when configured
BACKEND_SERVICE_KEY=

# Firebase console > Project settings > Your apps > Web app config.
# These identify your public web app; never put a service-account/private key here.
# Enable Google in Authentication > Sign-in method, and authorize localhost/your domain.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional for Firebase Authentication
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
